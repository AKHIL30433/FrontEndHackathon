# Environment Variables Template
# Copy this file to .env and update the values

# Builder.io API Key
VITE_PUBLIC_BUILDER_KEY=your_builder_key_here

# Server Configuration
PING_MESSAGE="ping pong"

# MongoDB Configuration
# For local MongoDB instance
MONGODB_URI=mongodb://localhost:27017/nova-verse

# For MongoDB Atlas (cloud)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/nova-verse?retryWrites=true&w=majority

# JWT Secret
# IMPORTANT: Change this to a strong, random secret in production!
JWT_SECRET=your-super-secret-jwt-key-change-in-production
